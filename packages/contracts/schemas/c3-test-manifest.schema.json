{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://j26-se-331.local/contracts/c3-test-manifest.schema.json",
  "title": "C3 -> C4: test_manifest.json",
  "description": "Producer: C3 (Tharsiga). Consumer: C4 (Shajana). Lists every runnable test and stub with its IDs. 'jest_full_name' must be exactly the name Jest/StrykerJS reports (describe title + ' ' + test title), so C4 can map Stryker per-test coverage back to IDs without guessing.",
  "type": "object",
  "allOf": [{ "$ref": "common.schema.json#/$defs/envelope" }],
  "required": ["contract", "subject_id", "runner", "tests", "stubs"],
  "properties": {
    "contract": { "const": "c3.test-manifest" },
    "subject_id": { "$ref": "common.schema.json#/$defs/subjectId" },
    "runner": {
      "type": "object",
      "required": ["name", "config_path"],
      "properties": {
        "name": { "const": "jest" },
        "version": { "type": "string" },
        "config_path": { "$ref": "common.schema.json#/$defs/relativePath" },
        "test_root": { "$ref": "common.schema.json#/$defs/relativePath" }
      },
      "additionalProperties": false
    },
    "tests": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "test_id", "scenario_id", "requirement_id", "file", "jest_full_name",
          "strategy", "assertion_categories", "verification", "repair_rounds"
        ],
        "properties": {
          "test_id": { "$ref": "common.schema.json#/$defs/testId" },
          "scenario_id": { "$ref": "common.schema.json#/$defs/scenarioId" },
          "requirement_id": { "$ref": "common.schema.json#/$defs/requirementId" },
          "file": { "$ref": "common.schema.json#/$defs/relativePath" },
          "jest_full_name": {
            "type": "string",
            "pattern": "^\\[REQ-[A-Z0-9]{2,10}-[0-9]{3,4}\\] .+ \\[SCN-[A-Z0-9]{2,10}-[0-9]{3,4}-[0-9]{2}\\]\\[TST-[A-Z0-9]{2,10}-[0-9]{3,4}-[0-9]{2}-[0-9]{2}\\] .+$"
          },
          "examples_row": { "type": "integer", "minimum": 1 },
          "boundary_ref": { "type": "string", "pattern": "^BV-[0-9]{2}$" },
          "partition_ref": { "type": "string", "pattern": "^EP-[0-9]{2}$" },
          "strategy": { "$ref": "common.schema.json#/$defs/generationStrategy" },
          "assertion_categories": {
            "type": "array",
            "minItems": 1,
            "items": { "$ref": "common.schema.json#/$defs/assertionCategory" }
          },
          "mock_decision_ids": { "type": "array", "items": { "type": "string", "pattern": "^MD-[0-9]{3}$" } },
          "verification": {
            "type": "object",
            "required": ["syntactic", "referential", "traceability", "semantic"],
            "properties": {
              "syntactic": { "$ref": "common.schema.json#/$defs/checkStatus" },
              "referential": { "$ref": "common.schema.json#/$defs/checkStatus" },
              "traceability": { "$ref": "common.schema.json#/$defs/checkStatus" },
              "semantic": {
                "type": "object",
                "required": ["status"],
                "properties": {
                  "status": { "$ref": "common.schema.json#/$defs/checkStatus" },
                  "score": { "$ref": "common.schema.json#/$defs/score01" }
                },
                "additionalProperties": false
              }
            },
            "additionalProperties": false
          },
          "repair_rounds": { "type": "integer", "minimum": 0, "maximum": 3 }
        },
        "additionalProperties": false
      }
    },
    "stubs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["stub_id", "scenario_id", "requirement_id", "file", "reason"],
        "properties": {
          "stub_id": { "$ref": "common.schema.json#/$defs/stubId" },
          "scenario_id": { "$ref": "common.schema.json#/$defs/scenarioId" },
          "requirement_id": { "$ref": "common.schema.json#/$defs/requirementId" },
          "file": { "$ref": "common.schema.json#/$defs/relativePath" },
          "reason": { "type": "string", "minLength": 5 }
        },
        "additionalProperties": false
      }
    }
  },
  "unevaluatedProperties": false
}
