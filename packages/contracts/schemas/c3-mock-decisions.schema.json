{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://j26-se-331.local/contracts/c3-mock-decisions.schema.json",
  "title": "C3 -> C4 / human review: mock_decisions.json",
  "description": "Producer: C3. Consumer: C4 (to diagnose 'incomplete_mock' gaps) and human reviewers. One entry per (scenario, dependency) pair. The mock/no_mock decision comes from a rule (rule_id); the model only fills 'behaviour'.",
  "type": "object",
  "allOf": [{ "$ref": "common.schema.json#/$defs/envelope" }],
  "required": ["contract", "subject_id", "decisions"],
  "properties": {
    "contract": { "const": "c3.mock-decisions" },
    "subject_id": { "$ref": "common.schema.json#/$defs/subjectId" },
    "rules_version": { "$ref": "common.schema.json#/$defs/semver" },
    "decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["decision_id", "scenario_id", "module_path", "dependency", "decision", "rule_id", "reason"],
        "properties": {
          "decision_id": { "type": "string", "pattern": "^MD-[0-9]{3}$" },
          "scenario_id": { "$ref": "common.schema.json#/$defs/scenarioId" },
          "module_path": { "$ref": "common.schema.json#/$defs/relativePath" },
          "dependency": {
            "type": "object",
            "required": ["import_specifier", "symbol", "kind"],
            "properties": {
              "import_specifier": { "type": "string", "description": "e.g. './userRepository' or 'fs'." },
              "symbol": { "type": "string" },
              "kind": { "enum": ["external_package", "node_builtin", "internal_module", "global_object"] },
              "resolved_path": { "type": "string" },
              "type_signature": { "type": "string" },
              "side_effect": { "enum": ["io", "network", "time", "random", "database", "none", "unknown"] }
            },
            "additionalProperties": false
          },
          "decision": { "enum": ["mock", "no_mock"] },
          "rule_id": { "type": "string", "pattern": "^R-[0-9]{2}$" },
          "reason": { "type": "string", "minLength": 5 },
          "behaviour": {
            "type": ["object", "null"],
            "required": ["derived_from_steps", "summary", "rationale"],
            "properties": {
              "derived_from_steps": { "type": "array", "items": { "type": "string" } },
              "summary": { "type": "string", "description": "What the mock returns/throws, in plain words." },
              "rationale": { "type": "string" },
              "model": { "type": "string" }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    }
  },
  "unevaluatedProperties": false
}
