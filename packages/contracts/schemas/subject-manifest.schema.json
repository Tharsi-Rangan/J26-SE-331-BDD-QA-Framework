{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://j26-se-331.local/contracts/subject-manifest.schema.json",
  "title": "Subject manifest (shared, owned by C3 + C4)",
  "description": "Says which code each requirement is about. C1 and C2 stay code-agnostic; C3 and C4 join on requirement_id to find the module under test.",
  "type": "object",
  "required": ["contract", "schema_version", "subjects"],
  "properties": {
    "contract": { "const": "shared.subject-manifest" },
    "schema_version": { "$ref": "common.schema.json#/$defs/semver" },
    "subjects": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["subject_id", "project", "project_code", "source", "module_path", "exports", "requirement_ids"],
        "properties": {
          "subject_id": { "$ref": "common.schema.json#/$defs/subjectId" },
          "project": { "type": "string", "description": "BugsJS project name, or 'example' for the teaching fixture." },
          "project_code": { "$ref": "common.schema.json#/$defs/projectCode" },
          "source": {
            "type": "object",
            "required": ["kind"],
            "properties": {
              "kind": { "enum": ["bugsjs", "example"] },
              "bug_id": { "type": "string", "description": "BugsJS bug identifier exactly as BugsJS names it." },
              "buggy_ref": { "type": "string", "description": "Git ref/commit of the buggy version." },
              "fixed_ref": { "type": "string", "description": "Git ref/commit of the fixed version." },
              "repo_path": { "$ref": "common.schema.json#/$defs/relativePath" }
            },
            "additionalProperties": false
          },
          "module_path": {
            "$ref": "common.schema.json#/$defs/relativePath",
            "description": "File under test, relative to the subject repo root."
          },
          "exports": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string" },
            "description": "Exported functions/classes the requirements talk about."
          },
          "module_system": { "enum": ["commonjs", "esm"], "default": "commonjs" },
          "jest_config": { "$ref": "common.schema.json#/$defs/relativePath" },
          "requirement_ids": {
            "type": "array",
            "minItems": 1,
            "items": { "$ref": "common.schema.json#/$defs/requirementId" }
          },
          "notes": { "type": "string" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
