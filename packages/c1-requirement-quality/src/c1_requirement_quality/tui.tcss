Screen { background: $surface; }
Header { background: $primary-background; }
.title { color: $accent; text-style: bold; padding: 1 2; height: auto; }
.subtitle, .hint { color: $text-muted; padding: 1 2; height: auto; }
#welcome { width: 80; max-width: 95%; height: auto; margin: 2 4; border: round $accent; }
#main-menu { height: 12; margin: 1 2; }
#dialog { width: 90%; max-width: 120; height: 90%; padding: 1 2; border: round $accent; background: $surface; }
ModalScreen { align: center middle; background: $background 70%; }
#dialog VerticalScroll { height: 1fr; }
#dialog TextArea { height: 6; min-height: 4; border: solid $primary; }
#dialog Input, #dialog Select { margin-bottom: 1; }
#dialog Label { height: auto; margin-top: 1; }
#dialog SelectionList { height: 9; }
.buttons { height: auto; min-height: 3; }
Button { margin: 0 1; }
#summary { padding: 1 2; background: $primary-background; height: auto; }
#review-layout { height: 1fr; }
#requirement-list { width: 42%; min-width: 28; border-right: solid $primary; }
#requirement-details { width: 1fr; }
#requirements { height: 1fr; }
#requirement-text { padding: 1 2; }
#details-scroll { height: 1fr; }
#actions { height: 12; border-top: solid $primary; }
#operation-status, #analysis-result { height: auto; padding: 1 2; color: $warning; }
#stages { height: auto; padding: 1 2; }
#preview-text { padding: 1 2; }
#form-error { color: $error; height: auto; }
.narrow #review-layout { layout: vertical; }
.narrow #requirement-list { width: 100%; height: 12; }
.narrow #requirement-details { width: 100%; height: 1fr; }
.pair-comparison { height: auto; }
.pair-comparison Static { width: 1fr; height: auto; padding: 1; border: round $primary; }
.compact .pair-comparison { layout: vertical; }
.compact .pair-comparison Static { width: 100%; }
