# Shared local model endpoint (SH-07). Copy to .env and keep .env out of git.
# Ollama serves an OpenAI-compatible API on this address.
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=qwen2.5-coder:7b-instruct
EMBEDDING_MODEL=nomic-embed-text

# Opt-in generate-candidates --backend groq; never commit real credentials.
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b

# Optional bounded Groq settings; no retries or model substitution.
GROQ_TIMEOUT_SECONDS=30
GROQ_MAX_OUTPUT_TOKENS=512
