# C3 model settings (C3-06). Copy to .env (never commit .env). Switching model = edit this file only.
#
# Daily development: local Ollama with a small model (free, offline)
#   ollama pull qwen2.5-coder:3b
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=qwen2.5-coder:3b
LLM_API_KEY=ollama
#
# Official runs (results we report): Hugging Face Inference Providers, official model, provider pinned
# (approved by the supervisor on 11 Oct). Token needs the "Make calls to Inference Providers" permission.
# LLM_BASE_URL=https://router.huggingface.co/v1
# LLM_MODEL=Qwen/Qwen2.5-Coder-7B-Instruct:nscale
# LLM_API_KEY=hf_xxxxxxxxxxxxxxxxx
#
# Optional
# LLM_TIMEOUT_MS=60000
# LLM_MAX_RETRIES=2
# LLM_CACHE=readwrite        # readwrite (default) | readonly (offline demo: cached answers only) | off
# LLM_CACHE_DIR=model-cache  # default: packages/c3-test-generation/model-cache
